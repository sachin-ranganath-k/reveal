{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "votes.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/votes/?$",
      "dest": "/votes.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
